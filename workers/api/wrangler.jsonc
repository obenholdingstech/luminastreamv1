{
  // Cloudflare Worker: the LuminaStream API (admin gate + LiveKit token mint).
  // JSONC is Cloudflare's recommended config format. Deploy + secret commands
  // live in the repo README ("API Worker" section).
  //
  // Two environments:
  //   - TOP-LEVEL   = production ("luminastream-api"), deployed ONLY by the
  //     merge workflow (.github/workflows/deploy-worker.yml) on push to main.
  //   - env.staging = "luminastream-api-staging", the default target for
  //     manual/agent deploys (`npm run deploy` → wrangler deploy --env staging).
  //
  // ratelimits, vars, durable_objects, migrations and observability are all
  // NON-inheritable by named environments, so staging repeats every one of them
  // with its own ids (isolated counters, and its own Durable Object namespace —
  // a staging deploy must never be able to fill production's capacity).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luminastream-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "VERIFY_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "TOKEN_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    // Session routes: create/end/capacity. Looser than the password oracle,
    // tighter than the mint — every call here reaches the Durable Object, and
    // on Workers Free the DO's daily request quota is a shared, exhaustible
    // resource (ROADMAP.md §P1).
    { "name": "SESSION_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // Non-secret configuration, deliberately visible in a public repo: these are
  // operational limits, not credentials. Both are parsed STRICTLY — a
  // malformed value is fatal at request time (500), never a silent default.
  "vars": {
    // The rooms an agent is ACTUALLY serving, comma-separated. A session slot
    // is a room with an agent in it — nothing else is a slot — so this is the
    // physical capacity limit and `MAX_CONCURRENT_SESSIONS` can only lower it.
    // Two entries since 2 Aug 2026: the primary (lumina-agent.service) and the
    // template instance lumina-agent@luminastream-2. Growing further is one
    // `systemctl --user enable --now lumina-agent@<room>` on the box, its
    // gates confirmed, THEN the room added here — in that order, always.
    // Measured constant (2 Aug, 7.8GiB/4-core box): ~350 MiB per agent ⇒
    // ~19 RAM-bound; hold ≤6 until CPU under concurrent load is measured.
    "SESSION_ROOMS": "luminastream-test,luminastream-2",
    // Policy ceiling on top of the pool. Effective capacity is
    // min(pool size, this), so it can never admit MORE sessions than there
    // are agents. It may equal that number — min permits equality — it just
    // cannot exceed it.
    "MAX_CONCURRENT_SESSIONS": "2",
    // 2h. Simultaneously the maximum session length and the maximum time an
    // abandoned slot stays held. Hard-capped by the 6h LiveKit grant ceiling.
    "SESSION_LEASE_SECONDS": "7200"
  },
  // The session layer's coordination state. SQLite-backed, which is the only
  // Durable Object class available on Workers Free.
  "durable_objects": {
    "bindings": [{ "name": "SESSION_REGISTRY", "class_name": "SessionRegistry" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRegistry"] }],
  "env": {
    "staging": {
      "name": "luminastream-api-staging",
      "observability": { "enabled": true },
      "ratelimits": [
        { "name": "VERIFY_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
        { "name": "TOKEN_LIMITER", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
        { "name": "SESSION_LIMITER", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
      ],
      "vars": {
        // NO AGENT RUNS FOR STAGING, so staging hands out no sessions.
        //
        // A pool is a promise that someone is listening. Listing rooms nobody
        // serves would issue valid credentials for silence — the exact failure
        // the room pool replaced, reintroduced through configuration instead of
        // code. Staging says so plainly instead.
        //
        // The rooms below are what a staging agent WOULD join. To turn staging
        // on: start `convert_agent.py --room staging-room-1` (and friends) on a
        // box, flip this to "true", and update the tripwire in
        // test/sessionRegistry.test.js in the SAME commit — it exists to make
        // this a deliberate act rather than a one-character edit.
        //
        // Never point staging at a room production is serving: two registries
        // handing out one room is the same eviction bug through another door.
        "SESSIONS_ENABLED": "false",
        "SESSION_ROOMS": "staging-room-1,staging-room-2,staging-room-3,staging-room-4",
        "MAX_CONCURRENT_SESSIONS": "4",
        "SESSION_LEASE_SECONDS": "7200"
      },
      "durable_objects": {
        "bindings": [{ "name": "SESSION_REGISTRY", "class_name": "SessionRegistry" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRegistry"] }]
    }
  }
  // Secrets (ADMIN_PASSWORD, ADMIN_SESSION_SECRET, LIVEKIT_API_KEY,
  // LIVEKIT_API_SECRET, LIVEKIT_URL) are NEVER declared here — set per
  // environment with `wrangler secret put <NAME> [--env staging]`
  // (see scripts/put-worker-secrets.sh) or `.dev.vars` locally.
}
